{
	"name": "@deltafold/release",
	"version": "0.0.1",
	"description": "Plan and apply local releases for packages modeled with deltafold.",
	"keywords": [
		"changelog",
		"deltafold",
		"effect",
		"monorepo",
		"release",
		"semver",
		"typescript",
		"versioning"
	],
	"homepage": "https://github.com/YLfjuk/deltafold/tree/main/packages/release#readme",
	"bugs": {
		"url": "https://github.com/YLfjuk/deltafold/issues"
	},
	"license": "MIT",
	"author": "YLfjuk (https://github.com/YLfjuk)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YLfjuk/deltafold.git",
		"directory": "packages/release"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"@deltafold/dev.src": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./changelog": {
			"@deltafold/dev.src": "./src/changelog.ts",
			"default": "./dist/changelog.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./changelog": "./dist/changelog.js",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
		"test": "vp test run"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "catalog:",
		"@effect/vitest": "catalog:",
		"@types/node": "26.6.6",
		"deltafold": "workspace:*",
		"effect": "catalog:",
		"publint": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"deltafold": "workspace:^",
		"effect": "catalog:"
	}
}
