{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": false,
		"declarationMap": false,
		"types": ["node"],
		"paths": {
			"@deltafold/release": ["./src/index.ts"]
		}
	},
	// Give the linter a project for hidden fixture modules that import workspace packages.
	"files": [
		"e2e/__fixtures__/workspace/.deltafold/change.ts",
		"e2e/__fixtures__/workspace/packages/adapter/.deltafold/package.ts",
		"e2e/__fixtures__/workspace/packages/adapter/.deltafold/versions/1.2.0.ts",
		"e2e/__fixtures__/workspace/packages/widgets/.deltafold/package.ts",
		"e2e/__fixtures__/workspace/packages/widgets/.deltafold/versions/1.2.0.ts",
		"e2e/__fixtures__/workspace/packages/widgets/.deltafold/versions/index.ts"
	],
	"include": ["e2e", "../../@types"]
}
