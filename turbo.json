{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig.base.json",
				"$TURBO_ROOT$/@types/**"
			],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig.base.json",
				"$TURBO_ROOT$/@types/**"
			],
			"outputs": []
		},
		"test": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig.base.json",
				"$TURBO_ROOT$/@types/**"
			],
			"outputs": []
		}
	}
}
