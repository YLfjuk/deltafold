{
	"name": "deltafold-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "effect-tsgo vp lint",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"check": "vp fmt --check && effect-tsgo vp lint && turbo run typecheck build test",
		"changeset": "changeset",
		"version": "changeset version"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@effect/tsgo": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	},
	"packageManager": "pnpm@12.18.0"
}
